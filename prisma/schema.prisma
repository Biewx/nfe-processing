// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Invoice{
  @@map("invoices")
  id Int @id @default(autoincrement())
  accessKey String @unique
  number Int
  series Int
  issuedAt DateTime
  operationNature String @db.VarChar(60)
  totalValue Decimal @db.Decimal(15, 2)
  supplierId Int
  supplier Supplier @relation(fields: [supplierId], references: [id])
  items InvoiceItem[]
  xmlStorageKey String?
  // dono da nota -- é aqui que o isolamento entre empresas acontece de
  // verdade. Supplier/Product continuam globais (catálogo compartilhado);
  // quem comprou o quê, por quanto, mora na Invoice.
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company{
  @@map("companies")
  id Int @id @default(autoincrement())
  name String @db.VarChar(120)
  invoices Invoice[]
  users User[]
  monthlyReportRuns MonthlyReportRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MonthlyReportRunStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// Um registro por (companyId, referenceMonth, referenceYear) -- e o que
// garante idempotencia (AD-5): o job mensal so cria linha PENDING se nao
// existir uma pro mesmo ciclo, e o drain so envia se a transicao
// PENDING -> SENDING for aceita atomicamente (evita double-send entre ticks
// sobrepostos). Nao guarda o conteudo do relatorio -- so agendamento e
// resultado, o conteudo e recomposto na hora do envio (AD-6).
model MonthlyReportRun{
  @@map("monthly_report_runs")
  @@unique([companyId, referenceMonth, referenceYear])
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  referenceMonth Int
  referenceYear Int
  status MonthlyReportRunStatus @default(PENDING)
  errorMessage String?
  scheduledAt DateTime
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User{
  @@map("users")
  id Int @id @default(autoincrement())
  email String @unique
  passwordHash String
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem{
  @@map("invoice_items")
  id Int @id @default(autoincrement())
  code String @db.VarChar(60)
  description String @db.VarChar(120)
  ncm String? @db.VarChar(8)
  commercialUnit String? @db.VarChar(10)
  cfop String? @db.VarChar(4)
  quantity Decimal @db.Decimal(15, 2)
  unitPrice Decimal @db.Decimal(15, 2)
  totalPrice Decimal @db.Decimal(15, 2)
  icmsValue Decimal? @db.Decimal(15, 2)
  pisValue Decimal? @db.Decimal(15, 2) 
  cofinsValue Decimal? @db.Decimal(15, 2)
  invoiceId Int
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  productId Int?
  product Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier{
  @@map("suppliers")
  id Int @id @default(autoincrement())
  cnpj String @unique @db.Char(14)
  legalName String @db.VarChar(120)
  tradeName String? @db.VarChar(120)
  stateRegistration String? @db.VarChar(60)
  city String @db.VarChar(60)
  state String @db.Char(2)
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product{
  @@map("products")
  id Int @id @default(autoincrement())
  description String @db.VarChar(120)
  invoiceItems InvoiceItem[]
  ean String? @db.VarChar(14) @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

